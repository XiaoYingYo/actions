[Version]
Signature="$CHICAGO$"
Class=HIDClass
ClassGuid={745a17a0-74d3-11d0-b6fe-00a0c90f57da}
Provider=%VENDOR%
DriverVer=03/27/2022,6.1.7600.16385
CatalogFile=linklook.cat

[SourceDisksFiles]
linklook.sys = 99
hidkmdf.sys = 99
WdfCoInstaller01009.dll=99 ; make sure the number matches with SourceDisksNames

[SourceDisksNames]
99 = %DISK_NAME%,,,""

[DestinationDirs]
CopyFunctionDriver = 12     
linklook.Inst_CoInstaller_CopyFiles = 11 

[Manufacturer]
%VENDOR%=Vendor, NTAMD64, NTAMD64.6.1

; For XP and later
[Vendor.NTAMD64]
%linklook%    = linklook.Inst, HID\linklook

; For Win7 and later so that we can use inbox HID-KMDF mapper
[Vendor.NTAMD64.6.1]
%linklook%    = linklook.Inst.Win7, HID\linklook

;===============================================================
;   linklook for XP thru Vista
;===============================================================
[linklook.Inst.NT]
CopyFiles = CopyFunctionDriver

[linklook.Inst.NT.HW]
AddReg = linklook_Parameters.AddReg 

;
; linklook is the function driver and hidkmdf is the WDM HID minidriver
;
[linklook.Inst.NT.Services]
AddService = hidkmdf,,hidkmdf_Service_Inst,
AddService = linklook,0x00000002, linklook_Service_Inst

[CopyFunctionDriver]
hidkmdf.sys
linklook.sys

[linklook_Parameters.AddReg]
HKR,,"UpperFilters",0x00010000,"hidkmdf"

[hidkmdf_Service_Inst]
DisplayName    = %hidkmdf.SVCDESC%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 3               ; SERVICE_DEMAND_START 
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %12%\hidkmdf.sys
LoadOrderGroup = PNP Filter

;===============================================================
;   linklook for Win7
;   Instead of using hidkmdf.sys as a filter, use the inbox 
;   mshidkmdf.sys as a mapper filter
;===============================================================
[linklook.Inst.Win7.NT]
; Just copy the driver. No neeed to copy other system binaries.
CopyFiles = CopyFunctionDriver

[linklook.Inst.Win7.NT.HW]
AddReg = linklook_Win7_Parameters.AddReg 

;
; linklook is the function driver and mshidkmdf is the WDM HID minidriver
;
[linklook.Inst.Win7.NT.Services]
AddService = linklook,0x00000002, linklook_Service_Inst

[linklook_Win7_Parameters.AddReg]
HKR,,"UpperFilters",0x00010000,"mshidkmdf"

;===============================================================
;   Sections common to all OS versions
;===============================================================

[linklook_Service_Inst]
;DisplayName    = %linklook%
ServiceType    = %SERVICE_KERNEL_DRIVER% 
StartType      = %SERVICE_DEMAND_START% 
ErrorControl   = %SERVICE_ERROR_IGNORE% 
ServiceBinary  = %12%\linklook.sys 

;================================================================
;--- WDF Coinstaller installation ------
;
[linklook.Inst.NT.CoInstallers]
AddReg=linklook.Inst_CoInstaller_AddReg
CopyFiles=linklook.Inst_CoInstaller_CopyFiles

[linklook.Inst_CoInstaller_AddReg]
HKR,,CoInstallers32,0x00010000, "WdfCoInstaller01009.dll,WdfCoInstaller"

[linklook.Inst_CoInstaller_CopyFiles]
WdfCoInstaller01009.dll,,,0x00000010    ;COPYFLG_NO_OVERWRITE (for win2k)

[linklook.Inst.NT.Wdf]
KmdfService = linklook, linklook_wdfsect
[linklook_wdfsect]
KmdfLibraryVersion = 1.9

[Strings] 
;  *******Localizable Strings******* 
VENDOR         = "Linklook" 
linklook       = "Linklook HID" 
DISK_NAME      = "Linklook Device Install Disk"
hidkmdf.SVCDESC= "Filter Driver Service for HID-KMDF Interface layer"

;  *******Non Localizable Strings******* 

SERVICE_BOOT_START     = 0x0 
SERVICE_SYSTEM_START   = 0x1 
SERVICE_AUTO_START     = 0x2 
SERVICE_DEMAND_START   = 0x3 
SERVICE_DISABLED       = 0x4 

SERVICE_KERNEL_DRIVER  = 0x1 
SERVICE_ERROR_IGNORE   = 0x0 
SERVICE_ERROR_NORMAL   = 0x1 
SERVICE_ERROR_SEVERE   = 0x2 
SERVICE_ERROR_CRITICAL = 0x3 

REG_EXPAND_SZ          = 0x00020000 
REG_DWORD              = 0x00010001 
REG_MULTI_SZ           = 0x00010000
REG_BINARY             = 0x00000001
REG_SZ                 = 0x00000000

