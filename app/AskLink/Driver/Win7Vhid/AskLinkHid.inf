[Version]
Signature="$CHICAGO$"
Class=HIDClass
ClassGuid={745a17a0-74d3-11d0-b6fe-00a0c90f57da}
Provider=%VENDOR%
DriverVer = 08/01/2025,1.0.0.0
CatalogFile=AskLinkHid.cat
PnpLockdown=1

[SourceDisksFiles]
AskLinkHid.sys = 99
AskLinkHidKmdf.sys = 99

[SourceDisksNames]
99 = %DISK_NAME%,,,""

[DestinationDirs]
CopyFunctionDriver = 12

[Manufacturer]
%VENDOR%=Vendor, NTAMD64

[Vendor.NTAMD64]
%AskLinkHid%    = AskLinkHid.Inst, AskLink\AskLinkHid

[AskLinkHid.Inst.NT]
CopyFiles = CopyFunctionDriver

[AskLinkHid.Inst.NT.HW]
AddReg = AskLinkHid_Parameters.AddReg 

[AskLinkHid.Inst.NT.Services]
AddService = AskLinkHidKmdf,,AskLinkHidKmdf_Service_Inst,
AddService = AskLinkHid,0x00000002, AskLinkHid_Service_Inst

[CopyFunctionDriver]
AskLinkHidKmdf.sys
AskLinkHid.sys

[AskLinkHid_Parameters.AddReg]
HKR,,"UpperFilters",0x00010000,"AskLinkHidKmdf"

[AskLinkHidKmdf_Service_Inst]
DisplayName    = %AskLinkHidKmdf.SVCDESC%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 3               ; SERVICE_DEMAND_START 
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %12%\AskLinkHidKmdf.sys
LoadOrderGroup = PNP Filter

[AskLinkHid_Service_Inst]
DisplayName    = %AskLinkHid%
ServiceType    = %SERVICE_KERNEL_DRIVER% 
StartType      = %SERVICE_DEMAND_START% 
ErrorControl   = %SERVICE_ERROR_IGNORE% 
ServiceBinary  = %12%\AskLinkHid.sys 

[AskLinkHid.Inst.NT.Wdf]
KmdfService = AskLinkHid, AskLinkHid_wdfsect
[AskLinkHid_wdfsect]
KmdfLibraryVersion = 1.9

[Strings] 
VENDOR         = "Shanghai Kongkong Technology Co., Ltd." 
AskLinkHid     = "AskLink HID b" 
DISK_NAME      = "AskLinkHid Device Install Disk"
AskLinkHidKmdf.SVCDESC = "AskLinkHid Filter Driver Service for HID-KMDF Interface layer"

SERVICE_BOOT_START     = 0x0 
SERVICE_SYSTEM_START   = 0x1 
SERVICE_AUTO_START     = 0x2 
SERVICE_DEMAND_START   = 0x3 
SERVICE_DISABLED       = 0x4 

SERVICE_KERNEL_DRIVER  = 0x1 
SERVICE_ERROR_IGNORE   = 0x0 
SERVICE_ERROR_NORMAL   = 0x1 
SERVICE_ERROR_SEVERE   = 0x2 
SERVICE_ERROR_CRITICAL = 0x3 

REG_EXPAND_SZ          = 0x00020000 
REG_DWORD              = 0x00010001 
REG_MULTI_SZ           = 0x00010000
REG_BINARY             = 0x00000001
REG_SZ                 = 0x00000000
